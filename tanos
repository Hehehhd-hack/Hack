checkRequirements = function(weaponName)
    local weapon = nil
    for _, w in ipairs(WeaponDB) do
        if w.name == weaponName then weapon = w; break end
    end
    if not weapon then return false, {"Unknown weapon"} end
    local missing = {}
    if weapon.requirements.kills > 0 then
        local c = State.KillCount or 0
        if c < weapon.requirements.kills then
            table.insert(missing, string.format("Kills: %s / %s", fmt(c), fmt(weapon.requirements.kills)))
        end
    end
    if weapon.requirements.fragments > 0 then
        local c = State.FragmentCount or 0
        if c < weapon.requirements.fragments then
            table.insert(missing, string.format("Frags: %s / %s", fmt(c), fmt(weapon.requirements.fragments)))
        end
    end
    for _, stone in ipairs(weapon.requirements.stones or {}) do
        local key = stone:gsub(" Stone", "")
        if not Config.StonesCollected[key] and not State.StonesCollected[key] then
            table.insert(missing, "Missing: " .. stone)
        end
    end
    local owned = getOwnedItems()
    for _, item in ipairs(weapon.requirements.items or {}) do
        local found = false
        for _, o in ipairs(owned) do
            if o:lower():find(item:lower()) or item:lower():find(o:lower()) then
                found = true; break
            end
        end
        if not found then table.insert(missing, "Missing: " .. item) end
    end
    return #missing == 0, missing
end

autoEquipBest = function()
    if not Config.AutoEquipBest then return end
    local char = getCharacter()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local bestPriority = -1
    local bestTool = nil
    local function check(tool)
        for _, w in ipairs(WeaponDB) do
            if tool.Name:lower():find(w.name:lower()) or w.name:lower():find(tool.Name:lower()) then
                if w.autoEquipPriority > bestPriority then
                    bestPriority = w.autoEquipPriority; bestTool = tool
                end
                return
            end
        end
        if bestPriority < 1 then bestPriority = 1; bestTool = tool end
    end
    for _, o in ipairs(char:GetChildren()) do
        if o:IsA("Tool") then check(o) end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, o in ipairs(bp:GetChildren()) do
            if o:IsA("Tool") then check(o) end
        end
    end
    if bestTool and bestTool.Parent then
        pcall(function() hum:EquipTool(bestTool) end)
    end
end

