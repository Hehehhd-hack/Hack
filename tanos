        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel = 0
        Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 6)

        local state = default
        local function apply(v)
            state = v
            local tp = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
            local tc = state and Theme.Emerald or Theme.Border
            TweenService:Create(knob, TweenInfo.new(0.1), {Position = tp}):Play()
            TweenService:Create(pill, TweenInfo.new(0.1), {BackgroundColor3 = tc}):Play()
            if callback then pcall(callback, state) end
        end
        h.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                apply(not state)
            end
        end)
    end

