getCharacter = function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return nil end
    return char
end

getHRP = function()
    local c = getCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end

getHumanoid = function()
    local c = getCharacter()
    return c and c:FindFirstChildOfClass("Humanoid")
end

teleportTo = function(position)
    local hrp = getHRP()
    if not hrp then return false end
    pcall(function() hrp.Velocity = Vector3.new(0, 0, 0) end)
    local ok = pcall(function()
        if typeof(position) == "CFrame" then hrp.CFrame = position
        elseif typeof(position) == "Vector3" then hrp.CFrame = CFrame.new(position) end
    end)
    if ok then Config.TeleportCount = Config.TeleportCount + 1 end
    return ok
end

