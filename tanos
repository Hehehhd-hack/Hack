    local function makeSlider(parent, name, min, max, default, callback, order)
        local h = Instance.new("Frame")
        h.Size = UDim2.new(1, 0, 0, 40)
        h.BackgroundColor3 = Theme.CardSub
        h.BorderSizePixel = 0
        h.LayoutOrder = order or 0
        h.Parent = parent
        Instance.new("UICorner", h).CornerRadius = UDim.new(0, 8)

        local l = Instance.new("TextLabel", h)
        l.Size = UDim2.new(1, -60, 0, 14)
        l.Position = UDim2.new(0, 12, 0, 5)
        l.BackgroundTransparency = 1
        l.Text = name
        l.TextColor3 = Theme.Text
        l.Font = Enum.Font.Gotham
        l.TextSize = 10
        l.TextXAlignment = Enum.TextXAlignment.Left

        local vLbl = Instance.new("TextLabel", h)
        vLbl.Size = UDim2.new(0, 44, 0, 14)
        vLbl.Position = UDim2.new(1, -56, 0, 5)
        vLbl.BackgroundTransparency = 1
        vLbl.Text = tostring(default)
        vLbl.TextColor3 = Theme.PurpleBright
        vLbl.Font = Enum.Font.GothamBold
        vLbl.TextSize = 10
        vLbl.TextXAlignment = Enum.TextXAlignment.Right

        local track = Instance.new("Frame", h)
        track.Size = UDim2.new(1, -24, 0, 4)
        track.Position = UDim2.new(0, 12, 0, 26)
        track.BackgroundColor3 = Theme.BorderDim
        track.BorderSizePixel = 0
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame", track)
        fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        fill.BackgroundColor3 = Theme.Purple
        fill.BorderSizePixel = 0
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local knob = Instance.new("Frame", track)
        knob.Size = UDim2.new(0, 11, 0, 11)
        knob.Position = UDim2.new((default - min) / (max - min), -5, 0.5, -5.5)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel = 0
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
        Instance.new("UIStroke", knob).Color = Theme.Purple

        local draggingSlider = false
        local function update(input)
            local tp = track.AbsolutePosition.X
            local ts = track.AbsoluteSize.X
            local x = math.clamp(input.Position.X - tp, 0, ts)
            local pct = x / ts
            local val = min + (max - min) * pct
            fill.Size = UDim2.new(pct, 0, 1, 0)
            knob.Position = UDim2.new(pct, -5, 0.5, -5.5)
            vLbl.Text = tostring(math.floor(val))
            if callback then callback(math.floor(val)) end
        end
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = true
                update(input)
            end
        end)
        local function sd(input)
            if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement
               or input.UserInputType == Enum.UserInputType.Touch) then
                update(input)
            end
        end
        track.InputChanged:Connect(sd)
        UserInputService.InputChanged:Connect(sd)
        track.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = false
            end
        end)
    end

