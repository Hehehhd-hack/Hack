checkRequirements = function(weaponName)
    local weapon = nil
    for _, w in ipairs(WeaponDB) do
        if w.name == weaponName then weapon = w; break end
    end
    if not weapon then return false, {"Unknown weapon"} end
    local missing = {}
    if weapon.requirements.kills > 0 then
        local currentKills = State.KillCount or 0
        if currentKills < weapon.requirements.kills then
            table.insert(missing, string.format("Kills: %s / %s", fmt(currentKills), fmt(weapon.requirements.kills)))
        end
    end
    if weapon.requirements.fragments > 0 then
        local currentFrags = State.FragmentCount or 0
        if currentFrags < weapon.requirements.fragments then
            table.insert(missing, string.format("Frags: %s / %s", fmt(currentFrags), fmt(weapon.requirements.fragments)))
        end
    end
    for _, stone in ipairs(weapon.requirements.stones or {}) do
        local stoneKey = stone:gsub(" Stone", "")
        if not Config.StonesCollected[stoneKey] and not State.StonesCollected[stoneKey] then
            table.insert(missing, "Missing: " .. stone)
        end
    end
    local ownedItems = getOwnedItems()
    for _, item in ipairs(weapon.requirements.items or {}) do
        local found = false
        for _, owned in ipairs(ownedItems) do
            if owned:lower():find(item:lower()) or item:lower():find(owned:lower()) then
                found = true; break
            end
        end
        if not found then table.insert(missing, "Missing: " .. item) end
    end
    return #missing == 0, missing
end

autoEquipBest = function()
    if not Config.AutoEquipBest then return end
    local char = getCharacter()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local bestPriority = -1
    local bestTool = nil
    local function checkTool(tool)
        for _, weapon in ipairs(WeaponDB) do
            if tool.Name:lower():find(weapon.name:lower()) or weapon.name:lower():find(tool.Name:lower()) then
                if weapon.autoEquipPriority > bestPriority then
                    bestPriority = weapon.autoEquipPriority
                    bestTool = tool
                end
                return
            end
        end
        if bestPriority < 1 then bestPriority = 1; bestTool = tool end
    end
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Tool") then checkTool(obj) end
    end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, obj in ipairs(backpack:GetChildren()) do
            if obj:IsA("Tool") then checkTool(obj) end
        end
    end
    if bestTool and bestTool.Parent then
        pcall(function() hum:EquipTool(bestTool) end)
    end
end

