local function templarFarmLoop()
    task.spawn(function()
        while Config.AutoTemplarFarm do
            pcall(function()
                local t = getClosestNPC(function(n) return n.name:lower():find("templar") end)
                if t then
                    local prev = Config.AutoKill
                    Config.AutoKill = true
                    local killed = throwAboveKill(t)
                    if not prev then Config.AutoKill = false end
                    if killed then
                        State.FragmentCount = (State.FragmentCount or 0) + 1
                    end
