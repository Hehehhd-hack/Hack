getCharacter = function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return nil end
    return char
end

getHRP = function()
    local c = getCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end

getHumanoid = function()
    local c = getCharacter()
    return c and c:FindFirstChildOfClass("Humanoid")
end

teleportTo = function(position)
    local hrp = getHRP()
    if not hrp then return false end
    pcall(function() hrp.Velocity = Vector3.new(0, 0, 0) end)
    local ok = pcall(function()
        if typeof(position) == "CFrame" then hrp.CFrame = position
        elseif typeof(position) == "Vector3" then hrp.CFrame = CFrame.new(position) end
    end)
    return ok
end

isValidNPC = function(obj)
    if not obj or not obj.Parent then return false end
    if not obj:IsA("Model") then return false end
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not obj:FindFirstChild("HumanoidRootPart") then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    return true
end

getAllNPCs = function()
    local npcs = {}
    local ok, descendants = pcall(function() return Workspace:GetDescendants() end)
    if not ok then return npcs end
    for _, obj in ipairs(descendants) do
        if isValidNPC(obj) then
            table.insert(npcs, {
                model = obj,
                humanoid = obj:FindFirstChildOfClass("Humanoid"),
                hrp = obj:FindFirstChild("HumanoidRootPart"),
                name = obj.Name,
            })
        end
    end
    return npcs
end

getNPCsByName = function(namePart)
    local result = {}
    for _, npc in ipairs(getAllNPCs()) do
        if npc.name:lower():find(namePart:lower()) then table.insert(result, npc) end
    end
    return result
end

getClosestNPC = function(filterFn)
    local hrp = getHRP()
    if not hrp then return nil end
    local closest, closestDist = nil, math.huge
    local myPos = hrp.Position
    for _, npc in ipairs(getAllNPCs()) do
        if filterFn and not filterFn(npc) then continue end
        local dist = (npc.hrp.Position - myPos).Magnitude
        if dist < closestDist then closestDist = dist; closest = npc end
    end
    return closest
end

