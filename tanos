local function startRequirementFarm(weaponName)
    local canGet, missing, missingItems, weapon = checkRequirements(weaponName)
    if canGet then return true end
    if not weapon then return false end

    local started = {}

    if weapon.requirements.kills > 0 and (State.KillCount or 0) < weapon.requirements.kills then
        if not Config.AutoKill then
            Config.AutoKill = true
            autoKillLoop()
            table.insert(started, "Auto-Kill")
        end
    end

    if weapon.requirements.fragments > 0 and (State.FragmentCount or 0) < weapon.requirements.fragments then
        if not Config.AutoTemplarFarm then
            Config.AutoTemplarFarm = true
            templarFarmLoop()
            table.insert(started, "Templar Farm")
        end
    end

    for _, stone in ipairs(weapon.requirements.stones or {}) do
        local key = stone:gsub(" Stone", "")
        if not Config.StonesCollected[key] and not State.StonesCollected[key] then
            if not Config.AutoCollectStones then
                Config.AutoCollectStones = true
                autoCollectStonesLoop()
                table.insert(started, "Stone Collect")
            end
            break
        end
    end

    for _, item in ipairs(missingItems) do
        if item:lower():find("lunar") then
            if not Config.AutoCollectLunar then
                Config.AutoCollectLunar = true
                State.LunarFragment = false
                autoCollectLunarLoop()
                table.insert(started, "Lunar Fragment")
            end
        elseif item:lower():find("celestial") then
            if not Config.AutoCollectCelestial then
                Config.AutoCollectCelestial = true
                State.CelestialFragment = false
                autoCollectCelestialLoop()
                table.insert(started, "Celestial Fragment")
            end
        elseif item:lower():find("frost") or item:lower():find("present") then
            if not Config.AutoCollectFrost then
                Config.AutoCollectFrost = true
                State.FrostFragments = 0
                autoCollectFrostLoop()
                table.insert(started, "Frost Fragments")
            end
        end
    end

    if #started > 0 then
        Config.ReqFarmActive = true
        Config.ReqFarmTarget = weaponName
        return false, started
    end

    return false, {}
end

