    -- DRAG — FIXED (full screen, works on all sides)
    -- ============================================
    local dragging = false
    local dragStart, startPos

    -- The fix: clamp the ACTUAL screen position, not the raw Offset.
    -- Also uses scale 0 for returned UDim2 so offsets are absolute.
    local function clampPos(newX, newY, obj)
        local cam = Workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
        local size = obj.AbsoluteSize
        local margin = 25
        local clampedX = math.clamp(newX, -size.X + margin, vp.X - margin)
        local clampedY = math.clamp(newY, -size.Y + margin, vp.Y - margin)
        return UDim2.new(0, clampedX, 0, clampedY)
    end

    local function beginDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            -- Convert current position to absolute screen offset
            local cam = Workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
            startPos = {
                x = Main.Position.X.Scale * vp.X + Main.Position.X.Offset,
                y = Main.Position.Y.Scale * vp.Y + Main.Position.Y.Offset,
            }
        end
    end

    local function moveDrag(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - dragStart
        Main.Position = clampPos(startPos.x + delta.X, startPos.y + delta.Y, Main)
    end

    local function endDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end

    TitleBar.InputBegan:Connect(beginDrag)
    TitleBar.InputChanged:Connect(moveDrag)
    TitleBar.InputEnded:Connect(endDrag)
    UserInputService.InputChanged:Connect(moveDrag)
    UserInputService.InputEnded:Connect(endDrag)

