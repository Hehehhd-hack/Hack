            local now = os.clock()
            local total = 0
            for _, e in ipairs(Config.DPSWindow) do
                if now - e.time <= 5 then total = total + e.damage end
            end
            Config.CurrentDPS = total / 5
            task.wait(0.5)
        end
    end)
end

