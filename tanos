checkRequirements = function(weaponName)
    local weapon
    for _, w in ipairs(WeaponDB) do
        if w.name == weaponName then weapon = w; break end
    end
    if not weapon then return false, {"Unknown"}, {} end
    local missing = {}
    local missingItems = {}
    if weapon.requirements.kills > 0 and (State.KillCount or 0) < weapon.requirements.kills then
        table.insert(missing, string.format("Kills: %s/%s", fmt(State.KillCount or 0), fmt(weapon.requirements.kills)))
    end
    if weapon.requirements.fragments > 0 and (State.FragmentCount or 0) < weapon.requirements.fragments then
        table.insert(missing, string.format("Frags: %s/%s", fmt(State.FragmentCount or 0), fmt(weapon.requirements.fragments)))
    end
    for _, stone in ipairs(weapon.requirements.stones or {}) do
        local key = stone:gsub(" Stone", "")
        if not Config.StonesCollected[key] and not State.StonesCollected[key] then
            table.insert(missing, "Missing: " .. stone)
        end
    end
    local owned = getOwnedItems()
    for _, item in ipairs(weapon.requirements.items or {}) do
        local found = false
        for _, o in ipairs(owned) do
            if o:lower():find(item:lower()) or item:lower():find(o:lower()) then
                found = true; break
            end
        end
        if not found then
            table.insert(missing, "Missing: " .. item)
            table.insert(missingItems, item)
        end
    end
    return #missing == 0, missing, missingItems, weapon
end

autoEquipBest = function()
    if not Config.AutoEquipBest then return end
    local char = getCharacter()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local bestPriority, bestTool = -1, nil
    local function check(tool)
        for _, w in ipairs(WeaponDB) do
            if tool.Name:lower():find(w.name:lower()) or w.name:lower():find(tool.Name:lower()) then
                if w.priority > bestPriority then
                    bestPriority = w.priority; bestTool = tool
                end
                return
            end
        end
        if bestPriority < 1 then bestPriority = 1; bestTool = tool end
    end
    for _, o in ipairs(char:GetChildren()) do
        if o:IsA("Tool") then check(o) end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, o in ipairs(bp:GetChildren()) do
            if o:IsA("Tool") then check(o) end
        end
    end
    if bestTool and bestTool.Parent then
        pcall(function() hum:EquipTool(bestTool) end)
    end
end

local originalSizes = {}

local function expandHitbox(target, size)
    if not target or not target.Parent then return end
    local hrp = target:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not originalSizes[target] then
        originalSizes[target] = { size = hrp.Size, transparency = hrp.Transparency }
    end
    hrp.Size = Vector3.new(size, size, size)
    hrp.Transparency = Config.HitboxTransparency
    hrp.CanCollide = false
    hrp.BrickColor = BrickColor.new("Really red")
end

local function restoreAllHitboxes()
    for target, orig in pairs(originalSizes) do
        if target and target.Parent then
            local hrp = target:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Size = orig.size
                hrp.Transparency = orig.transparency
            end
        end
    end
    originalSizes = {}
end

local function getFixedClick()
    local cam = Workspace.CurrentCamera
    if not cam then return Vector2.new(0, 0) end
    return Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
end

local function throwAboveKill(npc)
    if not npc or not npc.model or not npc.model.Parent then return false end
    if not npc.humanoid or npc.humanoid.Health <= 0 then return true end
    local hrp = getHRP()
    if not hrp then return false end
    local tool = equipBestTool()
    local startTime = os.clock()
    local fixedClick = getFixedClick()

    expandHitbox(npc.model, Config.HitboxSize)
    if Config.FreezeTarget and npc.hrp then
        pcall(function() npc.hrp.Anchored = true end)
    end

    while Config.AutoKill do
        if not npc.model.Parent or not npc.humanoid then break end
        if npc.humanoid.Health <= 0 then
            if Config.FreezeTarget and npc.hrp then
                pcall(function() npc.hrp.Anchored = false end)
            end
            return true
        end
        if os.clock() - startTime > Config.KillLockTimeout then
            if Config.FreezeTarget and npc.hrp then
                pcall(function() npc.hrp.Anchored = false end)
            end
            return false
        end

        pcall(function()
            hrp.CFrame = CFrame.new(npc.hrp.Position + Vector3.new(0, Config.ThrowHeight, 0))
            hrp.Velocity = Vector3.new(0, -300, 0)
        end)

        if tool and tool.Parent and tool:FindFirstChild("Handle") then
            pcall(function()
                firetouchinterest(tool.Handle, npc.hrp, 0)
                task.wait(0.008)
                firetouchinterest(tool.Handle, npc.hrp, 1)
            end)
        end
        if tool then pcall(function() tool:Activate() end) end
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(fixedClick)
        end)
        task.wait(Config.KillDelay)
    end

    if Config.FreezeTarget and npc.hrp then
        pcall(function() npc.hrp.Anchored = false end)
    end
    return npc.humanoid.Health <= 0
end

local function autoKillLoop()
    task.spawn(function()
        while Config.AutoKill do
            pcall(function()
                local target = getClosestNPC()
                if target then
                    Config.CurrentTarget = target
                    if throwAboveKill(target) then
                        State.KillCount = (State.KillCount or 0) + 1
                    end
                    Config.CurrentTarget = nil
                    task.wait(0.05)
                else
                    task.wait(0.3)
                end
            end)
            task.wait(Config.KillDelay)
        end
        restoreAllHitboxes()
    end)
end

local function killAuraLoop()
    task.spawn(function()
        while Config.KillAura do
            pcall(function()
                local hrp = getHRP()
                if hrp then
                    local tool = equipBestTool()
                    for _, npc in ipairs(getAllNPCs()) do
                        if (npc.hrp.Position - hrp.Position).Magnitude <= Config.AuraRange then
                            expandHitbox(npc.model, Config.HitboxSize)
                            if tool and tool:FindFirstChild("Handle") then
                                pcall(function()
                                    firetouchinterest(tool.Handle, npc.hrp, 0)
                                    firetouchinterest(tool.Handle, npc.hrp, 1)
                                end)
                            end
                            if tool then pcall(function() tool:Activate() end) end
                        end
                    end
                end
            end)
            task.wait(Config.AuraSpeed)
        end
    end)
end

local function autoFarmLoop()
