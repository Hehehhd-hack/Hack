    makeSection(MiscTab, "Actions", 9)
    makeButton(MiscTab, "↺  Reset Character", function()
        local char = getCharacter()
        if char and char:FindFirstChildOfClass("Humanoid") then
            char.Humanoid.Health = 0
        end
    end, Theme.Crimson, 10)
    makeButton(MiscTab, "⇄  Rejoin", function()
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end, Theme.Blue, 11)

    -- UPDATER
    task.spawn(function()
        while ScreenGui.Parent do
            pcall(function()
                if KillVal then KillVal.Text = fmt(State.KillCount or 0) end
                local st = 0
                for _, c in pairs(Config.StonesCollected) do if c then st = st + 1 end end
                if StoneVal then StoneVal.Text = st .. "/6" end
                if FragVal then FragVal.Text = fmt(State.FragmentCount or 0) end
                local elapsed = os.time() - (State.InitTimestamp or os.time())
                if SessionLbl then SessionLbl.Text = "Time in session: " .. formatTime(elapsed) end
                if StatsBar then
                    StatsBar.Text = string.format("kills %s · stones %d/6 · frags %s",
                        fmt(State.KillCount or 0), st, fmt(State.FragmentCount or 0))
                end
                if FooterLbl then
                    FooterLbl.Text = string.format("k %s · st %d/6 · frags %s",
                        fmt(State.KillCount or 0), st, fmt(State.FragmentCount or 0))
                end
                local active = Config.AutoKill or Config.KillAura or Config.AutoFarm
                    or Config.AutoTemplarFarm or Config.AutoAstraWaves
                    or Config.AutoCollectStones or Config.AutoKillForUpgrade
                if StatusDot then
                    StatusDot.BackgroundColor3 = active and Theme.Emerald or Theme.TextMuted
                end
            end)
            task.wait(0.4)
        end
    end)

    switchTab("Home")
    Config.GUI = ScreenGui
    return ScreenGui
end

