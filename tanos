local function autoCollectStonesLoop()
    task.spawn(function()
        while Config.AutoCollectStones do
            pcall(function()
                local stones = {
                    { name = "Space", terms = {"space stone", "spacestone"} },
                    { name = "Reality", terms = {"reality stone"} },
                    { name = "Time", terms = {"time stone"} },
                    { name = "Mind", terms = {"mind stone"} },
                    { name = "Power", terms = {"power stone"} },
                    { name = "Soul", terms = {"soul stone"} },
                }
                for _, s in ipairs(stones) do
                    if not Config.StonesCollected[s.name] then
                        local obj = findObjectByTerms(s.terms)
                        if obj then
                            local part = obj:IsA("Model") and (obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")) or obj
                            if part and part:IsA("BasePart") then
                                local hrp = getHRP()
                                if hrp then
                                    hrp.CFrame = part.CFrame * CFrame.new(0, 3, 0)
                                    task.wait(0.3)
                                    fireTouch(hrp, part)
                                    Config.StonesCollected[s.name] = true
                                    State.StonesCollected[s.name] = true
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(2)
        end
    end)
end

