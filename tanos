    local dragging, dragStart, startAbsX, startAbsY = false, nil, 0, 0

    local function beginDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            local cam = Workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
            startAbsX = Main.Position.X.Scale * vp.X + Main.Position.X.Offset
            startAbsY = Main.Position.Y.Scale * vp.Y + Main.Position.Y.Offset
            Main.Position = UDim2.new(0, startAbsX, 0, startAbsY)
        end
    end

    local function moveDrag(input)
        if not dragging or not dragStart then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - dragStart
        local cam = Workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
        local size = Main.AbsoluteSize
        local margin = 25
        local nx = math.clamp(startAbsX + delta.X, -size.X + margin, vp.X - margin)
        local ny = math.clamp(startAbsY + delta.Y, -size.Y + margin, vp.Y - margin)
        Main.Position = UDim2.new(0, nx, 0, ny)
    end

    local function endDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            dragStart = nil
        end
    end

    TitleBar.InputBegan:Connect(beginDrag)
    TitleBar.InputChanged:Connect(moveDrag)
    TitleBar.InputEnded:Connect(endDrag)
    UIS.InputChanged:Connect(moveDrag)
    UIS.InputEnded:Connect(endDrag)

