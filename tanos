            elseif weapon.name == "Surtur's Sword" then
                searchTerms = {"surtur", "catacomb"}
            elseif weapon.name == "Hadron Enforcer" then
                searchTerms = {"lunar", "moon", "craft"}
            elseif weapon.name == "Cosmi-Rod" then
                searchTerms = {"celestial", "catacomb"}
            elseif weapon.name == "Secret Weapon" then
                searchTerms = {"secret", "sword"}
            elseif weapon.name == "Mechanical Gloves" then
                searchTerms = {"doom", "boss"}
            end
            local obj = findObjectByTerms(searchTerms)
            if obj then
                local part = obj:IsA("Model") and (obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")) or obj
                if part then
