                        task.wait(0.5)
                        pcall(function() LocalPlayer:GetMouse() mouse1click() end)
                    end
                end
            else
                notify("Location Not Found", "Could not find " .. weapon.name .. " spawn", Theme.Crimson, 3)
            end
