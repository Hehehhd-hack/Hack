-- ============================================
local function getCharacter()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return nil end
    return char
end

local function getHRP()
    local char = getCharacter()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = getCharacter()
    return char and char:FindFirstChildOfClass("Humanoid")
end

-- Anti-detection teleport
local function teleportTo(position)
    local hrp = getHRP()
    if not hrp then return false end

    if Config.ResetVelocity then
        pcall(function() hrp.Velocity = Vector3.new(0, 0, 0) end)
    end

    local ok = pcall(function()
        if typeof(position) == "CFrame" then
            hrp.CFrame = position
        elseif typeof(position) == "Vector3" then
            hrp.CFrame = CFrame.new(position)
        end
    end)

    if ok then
        Config.TeleportCount = Config.TeleportCount + 1
    end
    return ok
end

-- Randomized teleport offset (anti-detection)
local function getSafeOffset()
    if Config.RandomTeleportOffset then
        return CFrame.new(
            math.random(-20, 20) / 10,
            0,
            math.random(-20, 20) / 10
        )
    end
    return CFrame.new(0, 0, 0)
end

local function isValidNPC(obj)
    if not obj or not obj.Parent then return false end
    if not obj:IsA("Model") then return false end
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not obj:FindFirstChild("HumanoidRootPart") then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    return true
end

local function getAllNPCs()
    local npcs = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isValidNPC(obj) then
            table.insert(npcs, {
                model = obj,
                humanoid = obj:FindFirstChildOfClass("Humanoid"),
                hrp = obj:FindFirstChild("HumanoidRootPart"),
                name = obj.Name,
            })
        end
    end
    return npcs
end

local function getClosestNPC(filterFn)
    local hrp = getHRP()
    if not hrp then return nil, math.huge end

    local closest, closestDist = nil, math.huge
    local myPos = hrp.Position

    for _, npc in ipairs(getAllNPCs()) do
        if filterFn and not filterFn(npc) then continue end
        local dist = (npc.hrp.Position - myPos).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = npc
        end
    end
    return closest, closestDist
end

local function fireTouch(hit, target)
    if not hit or not target then return end
    pcall(function()
        firetouchinterest(hit, target, 0)
        task.wait(0.02)
        firetouchinterest(hit, target, 1)
    end)
end

local function findObjectByTerms(terms, types)
    types = types or {"Model", "BasePart"}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local objName = obj.Name:lower()
        for _, term in ipairs(terms) do
            if objName:find(term) then
                for _, t in ipairs(types) do
                    if obj:IsA(t) then return obj end
                end
            end
        end
    end
    return nil
end

local function formatNumber(n)
    if n >= 1e9 then return string.format("%.1fB", n / 1e9) end
    if n >= 1e6 then return string.format("%.1fM", n / 1e6) end
    if n >= 1e3 then return string.format("%.1fK", n / 1e3) end
    return tostring(n)
end

-- ============================================
-- HITBOX EXPANDER (from Blox Fruits patterns)
-- ============================================
local originalSizes = {}

local function expandHitbox(targetModel, size)
    if not targetModel or not targetModel.Parent then return end
    local hrp = targetModel:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not originalSizes[targetModel] then
        originalSizes[targetModel] = {
            size = hrp.Size,
            transparency = hrp.Transparency,
            cancollide = hrp.CanCollide,
        }
    end

    hrp.Size = Vector3.new(size, size, size)
    hrp.Transparency = Config.HitboxTransparency
    hrp.CanCollide = false
    hrp.BrickColor = BrickColor.new("Really red")
end

local function restoreHitbox(targetModel)
    if not targetModel or not targetModel.Parent then return end
    local hrp = targetModel:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local orig = originalSizes[targetModel]
    if orig then
        hrp.Size = orig.size
        hrp.Transparency = orig.transparency
        hrp.CanCollide = orig.cancollide
        hrp.BrickColor = BrickColor.new("Medium stone grey")
        originalSizes[targetModel] = nil
    end
end

local function hitboxLoop()
    task.spawn(function()
        while Config.HitboxExpand do
            pcall(function()
                for _, npc in ipairs(getAllNPCs()) do
                    expandHitbox(npc.model, Config.HitboxSize)
                end
                -- Also expand target models in HitboxTargets
                for model, _ in pairs(Config.HitboxTargets) do
                    if model and model.Parent then
                        expandHitbox(model, Config.HitboxSize)
                    end
                end
            end)
            task.wait(0.5)
        end
        -- Restore all on disable
        for _, npc in ipairs(getAllNPCs()) do
            restoreHitbox(npc.model)
        end
        for model, _ in pairs(Config.HitboxTargets) do
            restoreHitbox(model)
        end
    end)
end

-- ============================================
-- TOOL EQUIP (from Blox Fruits auto-kill)
-- ============================================
local function equipBestTool()
    local char = getCharacter()
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end

    -- Prefer gauntlet
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find("gauntlet") then
            pcall(function() hum:EquipTool(tool) end)
            return tool
        end
    end

    -- Fallback: any tool
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            pcall(function() hum:EquipTool(tool) end)
            return tool
        end
    end
    return nil
end

-- ============================================
-- KILL AURA (fixed — uses firetouchinterest + Activate)
-- ============================================
local function killAuraHit(npc)
    local char = getCharacter()
    if not char or not npc or not npc.hrp or not npc.humanoid then return end
    if not npc.model.Parent then return end
    if npc.humanoid.Health <= 0 then return end

    local hrp = getHRP()
    if not hrp then return end

    -- Equip tool
    local tool = equipBestTool()

    -- Method 1: firetouchinterest (Blox Fruits style)
    if tool and tool:FindFirstChild("Handle") then
        local handle = tool.Handle
        local targetPart = npc.hrp
        if Config.KillAuraHitPart == "Head" then
            targetPart = npc.model:FindFirstChild("Head") or npc.hrp
        end

        pcall(function()
            firetouchinterest(handle, targetPart, 0)
            task.wait(0.01)
            firetouchinterest(handle, targetPart, 1)
        end)
    end

    -- Method 2: Tool Activate
    if tool then
        pcall(function() tool:Activate() end)
    end

    -- Method 3: Mouse click (some games require this)
    pcall(function()
        local mouse = LocalPlayer:GetMouse()
        mouse1click()
    end)

    -- Method 4: Direct touch on all body parts (more reliable)
    for _, part in ipairs(npc.model:GetChildren()) do
        if part:IsA("BasePart") then
            fireTouch(hrp, part)
        end
    end
end

local function killAuraLoop()
    task.spawn(function()
        while Config.KillAura do
            pcall(function()
                local hrp = getHRP()
                if hrp then
                    for _, npc in ipairs(getAllNPCs()) do
                        if npc.hrp and (npc.hrp.Position - hrp.Position).Magnitude <= Config.KillAuraRange then
                            killAuraHit(npc)
                        end
                    end
                end
            end)
            task.wait(Config.KillAuraSpam and Config.KillAuraSpeed or 0.2)
        end
    end)
end

-- ============================================
-- AUTO FARM (fixed — teleport + verify + attack)
-- ============================================
local function attackTarget(npc)
    local hrp = getHRP()
    if not hrp or not npc or not npc.hrp or not npc.humanoid then return false end
    if not npc.model.Parent then return false end
    if npc.humanoid.Health <= 0 then return false end

    local initialHealth = npc.humanoid.Health

    -- Teleport with offset
    pcall(function()
        hrp.CFrame = npc.hrp.CFrame * CFrame.new(0, 0, Config.AttackDist) * getSafeOffset()
    end)

    -- Equip tool
    local tool = equipBestTool()

    -- Attack loop
    for i = 1, Config.HitsPerTarget do
        if tool and tool.Parent then
            pcall(function() tool:Activate() end)
        end

        -- Fire touch on target
        if tool and tool:FindFirstChild("Handle") then
            pcall(function()
                firetouchinterest(tool.Handle, npc.hrp, 0)
                task.wait(0.01)
                firetouchinterest(tool.Handle, npc.hrp, 1)
            end)
        end

        pcall(function()
            local mouse = LocalPlayer:GetMouse()
            mouse1click()
        end)

        task.wait(0.03)
    end

    task.wait(0.05)
    if not npc.humanoid or not npc.humanoid.Parent then return false end

    local damage = initialHealth - npc.humanoid.Health
    if damage > 0 then
        table.insert(Config.DPSWindow, { time = os.clock(), damage = damage })
        local now = os.clock()
        for i = #Config.DPSWindow, 1, -1 do
            if now - Config.DPSWindow[i].time > 5 then
                table.remove(Config.DPSWindow, i)
            end
        end
        return true
    end
    return false
end

local function autoFarmLoop()
    task.spawn(function()
        while Config.AutoFarm do
            local ok, err = pcall(function()
                if getCharacter() then
                    local npc = getClosestNPC()
                    if npc and npc.hrp then
                        local initialHealth = npc.humanoid.Health
                        attackTarget(npc)

                        if Config.VerifyKill then
                            task.wait(0.1)
                            if npc.humanoid and npc.humanoid.Health <= 0 and initialHealth > 0 then
                                State.KillCount = (State.KillCount or 0) + 1
                                State.SessionKills = (State.SessionKills or 0) + 1
                            end
                        else
                            State.KillCount = (State.KillCount or 0) + 1
                        end
                    end
                end
            end)
            if not ok then warn("[P] Farm error:", err) end
            task.wait(Config.FarmSpeed)
        end
    end)
end

