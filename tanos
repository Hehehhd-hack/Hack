getCharacter = function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return nil end
    return char
end

getHRP = function()
    local c = getCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end

getHumanoid = function()
    local c = getCharacter()
    return c and c:FindFirstChildOfClass("Humanoid")
end

isValidNPC = function(obj)
    if not obj or not obj.Parent then return false end
    if not obj:IsA("Model") then return false end
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not obj:FindFirstChild("HumanoidRootPart") then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    return true
end

getAllNPCs = function()
    local npcs = {}
    local ok2, desc = pcall(function() return Workspace:GetDescendants() end)
    if not ok2 then return npcs end
    for _, obj in ipairs(desc) do
        if isValidNPC(obj) then
            table.insert(npcs, {
                model = obj,
                humanoid = obj:FindFirstChildOfClass("Humanoid"),
                hrp = obj:FindFirstChild("HumanoidRootPart"),
                name = obj.Name,
            })
        end
    end
    return npcs
end

getNPCsByName = function(namePart)
    local result = {}
    for _, npc in ipairs(getAllNPCs()) do
        if npc.name:lower():find(namePart:lower()) then
            table.insert(result, npc)
        end
    end
    return result
end

getClosestNPC = function(filterFn)
    local hrp = getHRP()
    if not hrp then return nil end
    local closest, dist = nil, math.huge
    for _, npc in ipairs(getAllNPCs()) do
        if filterFn and not filterFn(npc) then continue end
        local d = (npc.hrp.Position - hrp.Position).Magnitude
        if d < dist then dist = d; closest = npc end
    end
    return closest
end

equipBestTool = function()
    local char = getCharacter()
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find("gauntlet") then
            pcall(function() hum:EquipTool(tool) end)
            return tool
        end
    end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            pcall(function() hum:EquipTool(tool) end)
            return tool
        end
    end
    return nil
end

fireTouch = function(hit, target)
